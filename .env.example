# ==========================================
# Zervuno Configuration - Environment Variables
# ==========================================

# Application
ENVIRONMENT=development
PROJECT_NAME="Zervuno"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Security
# In production, generate a 64-character random secret key
SECRET_KEY="zervuno-super-secret-key-change-in-production-f83b194a72d3e"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30
COOKIE_SECURE=false # Set to true in HTTPS production

# Database
# Local PostgreSQL default:
DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/zervuno"
# Neon Hosted PostgreSQL format:
# DATABASE_URL="postgresql+psycopg://user:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Storage
STORAGE_BACKEND="local" # "local" or "s3"
UPLOAD_DIR="uploads"
# Cloudflare R2 / S3 (optional for production object storage):
# S3_ENDPOINT_URL="https://<account-id>.r2.cloudflarestorage.com"
# S3_ACCESS_KEY_ID="your-r2-access-key"
# S3_SECRET_ACCESS_KEY="your-r2-secret-key"
# S3_BUCKET_NAME="zervuno-evidence"

# AI Integration (Google Gemini API)
# Optional: if omitted, system operates in grounded deterministic heuristic mode
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Email Delivery (Resend / SMTP)
RESEND_API_KEY=""
EMAIL_FROM="Zervuno <notifications@zervuno.com>"
